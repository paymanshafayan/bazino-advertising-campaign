<UserControl x:Class="BazinoMarketing.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BazinoMarketing.App.ViewModels"
             xmlns:views="clr-namespace:BazinoMarketing.App.Views"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma"
             Foreground="{StaticResource TextBrush}"
             FontSize="14"
             NumberSubstitution.Substitution="European"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <views:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}">
            <views:LogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
            <views:BrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaViewModel}">
            <views:MediaStudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PublishQueueViewModel}">
            <views:PublishQueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DailyReportViewModel}">
            <views:DailyReportView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar (right side in RTL) ===================== -->
        <Border Grid.Column="0" Width="248" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="18,20,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentSoftBrush}">
                            <Image Source="pack://application:,,,/Assets/bazino.png" Width="28" Height="28"
                                   FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ژینوس" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="دستیار بازاریابی بازینو" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,4,10,4">
                    <StackPanel>
                        <TextBlock Text="بخش‌ها" Style="{StaticResource Caption}" Margin="10,6,10,4" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsConnectionPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="🔌" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="اتصال" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsReportPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="📊" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="گزارش روزانه" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsPublishPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="📤" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="محتوای آماده انتشار" />
                        </RadioButton>

                        <TextBlock Text="ابزارها" Style="{StaticResource Caption}" Margin="10,16,10,4" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsMediaPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="🎬" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="رسانه و ویدئو" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsBrowserPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="🌐" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="مرورگر" />
                        </RadioButton>

                        <TextBlock Text="سیستم" Style="{StaticResource Caption}" Margin="10,16,10,4" />
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsSettingsPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="⚙️" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="تنظیمات" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource SideNavItem}" GroupName="Nav" IsChecked="{Binding IsLogPage, Mode=TwoWay}">
                            <RadioButton.Tag><TextBlock Text="📜" Style="{StaticResource SidebarIcon}" /></RadioButton.Tag>
                            <TextBlock Text="لاگ رویدادها" />
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: relay + version -->
                <StackPanel Grid.Row="2" Margin="14,8,14,16">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,12" />
                    <Border Style="{StaticResource Pill}" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding RelayDotBrush}" />
                            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource TextBrush}" Text="{Binding RelaySummary}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="2,8,0,0" Style="{StaticResource Caption}" Text="{Binding AppVersion}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Connection.ConnectedCountBrush, Mode=OneWay}" />
                                <TextBlock Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource TextBrush}">
                                    <Run Text="{Binding Connection.ConnectedCount, Mode=OneWay}" />
                                    <Run Text="ابزار متصل" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding MailboxDotBrush}" />
                                <TextBlock Margin="8,0,0,0" FontSize="12.5" Foreground="{StaticResource TextBrush}" Text="{Binding MailboxSummary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <ContentControl x:Name="PageHost" Content="{Binding CurrentContent}" Focusable="False"
                                RenderTransformOrigin="0.5,0.5" Opacity="1">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift" X="0" Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="24,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                        <Run Text="پوشهٔ داده: " />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="16,0,0,0"
                               Text="کلیدها فقط با DPAPI روی همین رایانه ذخیره می‌شوند و هرگز در لاگ یا Git نوشته نمی‌شوند." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
