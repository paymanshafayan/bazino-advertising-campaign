<UserControl x:Class="BazinoMarketing.App.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BazinoMarketing.App.ViewModels"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma"
             Foreground="{StaticResource TextBrush}"
             FontSize="14"
             NumberSubstitution.Substitution="European"
             Background="{StaticResource BgBrush}">
    <Grid Margin="24,18,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding ExplainText}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="520" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap">
                            <Run Text="وضعیت کروم: " />
                            <Run Text="{Binding ChromeRunning, Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding SelectedTargetText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="نوسازی وضعیت" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                        <Button Content="باز کردن کروم" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" Margin="0,0,6,0" />
                        <Button Content="قطع اتصال تب" Style="{StaticResource GhostButton}" Command="{Binding DetachCommand}" />
                    </WrapPanel>
                </Grid>
                <TextBlock Margin="0,8,0,0" Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Open a page -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                         ToolTip="هر نشانی معمولی http یا https که می‌خواهید باز کنید." />
                <Button Grid.Column="1" Content="باز کن و متن را بخوان" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Tabs already open in Chrome -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="تب‌های باز مرورگر" Style="{StaticResource Label}" />
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" MaxHeight="150" Margin="0,6,0,0"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
                                    <TextBlock Text=" — " Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Url}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <Button Grid.Column="1" Content="وصل شدن به تب" Command="{Binding SelectCommand}" VerticalAlignment="Bottom" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Page text -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PageTitle}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="کپی متن" Style="{StaticResource GhostButton}" Command="{Binding CopyTextCommand}" />
                </Grid>
                <TextBox Grid.Row="1" Style="{StaticResource MultilineTextBox}" Text="{Binding PageText, Mode=OneWay}"
                         IsReadOnly="True" Margin="16,0,16,16" />
            </Grid>
        </Border>

        <!-- Browser settings; no host allow-list remains. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="تنظیمات مرورگر" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="همهٔ نشانی‌های http و https قابل بازکردن‌اند. محدودیت میزبان حذف شده و محافظت خواندن رمز، کوکی و فضای ذخیرهٔ مرورگر حفظ شده است." />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="شمارهٔ پورت اتصال به مرورگر" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" ToolTip="پیش‌فرض ۹۳۳۴" />
                    <TextBlock Margin="0,8,0,0" Text="مسیر کروم (اگر خودش پیدا نشد)" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ChromePath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="مثال: C:\Program Files\Google\Chrome\Application\chrome.exe" />
                    <Button Content="ذخیرهٔ تنظیمات" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"
                            HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
