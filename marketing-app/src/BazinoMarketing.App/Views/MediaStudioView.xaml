<UserControl x:Class="BazinoMarketing.App.Views.MediaStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma"
             Foreground="{StaticResource TextBrush}"
             FontSize="14"
             NumberSubstitution.Substitution="European"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="22,16,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="دریافت پست، بررسی فایل و ویرایش با FFmpeg" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock Text="پوشهٔ رسانه" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding PendingFolderPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="پوشه‌ای که فایل‌ها در آن ذخیره و بررسی می‌شوند." />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                            <Run Text="پوشهٔ فعال: " /><Run Text="{Binding FolderPath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Content="مرور پوشه" Command="{Binding BrowseFolderCommand}" Margin="0,0,6,6" />
                        <Button Content="تأیید" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmFolderCommand}" Margin="0,0,6,6" />
                        <Button Content="باز کردن پوشه" Command="{Binding OpenFolderCommand}" Margin="0,0,6,6" />
                        <Button Content="نوسازی" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="0.98*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="پست Instagram انتخابی" Style="{StaticResource H2}" />
                        <TextBlock Text="فقط همین پیوندِ پست یا ریل دریافت می‌شود؛ صفحهٔ حساب یا بقیهٔ پست‌ها پیمایش نمی‌شوند." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding InstagramUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="نشانی کامل یک پست یا ریل Instagram" />
                            <Button Grid.Column="1" Content="گرفتن نشانی تب فعلی" Command="{Binding LoadCurrentTabCommand}" Margin="8,0" />
                            <Button Grid.Column="2" Content="دریافت همین پست" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="فایل‌های داخل پوشه" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding Files.Count, StringFormat={}{0} فایل}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Margin="8,0,8,8"
                                  Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RelativePath}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, StringFormat={}{0:N0} بایت}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <MediaElement x:Name="Player" Source="{Binding PreviewUri}" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          Stretch="Uniform" Volume="0.7"
                                          Visibility="{Binding IsVideoSelected, Converter={StaticResource BoolToVisibility}}" />
                            <Image Source="{Binding ImagePreviewUri}" Stretch="Uniform"
                                   Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="برای فایل انتخاب‌شده پیش‌نمایش تصویری موجود نیست." Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                    Visibility="{Binding IsVideoSelected, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="پخش" Click="Play_Click" Margin="0,0,6,0" />
                            <Button Content="مکث" Click="Pause_Click" Margin="0,0,6,0" />
                            <Button Content="توقف" Click="Stop_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="16,12" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ویرایش و خروجی با FFmpeg" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,10">
                            <Run Text="منبع: " /><Run Text="{Binding SelectedFileText, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="مسیر ffmpeg.exe (خالی = جست‌وجو در PATH)" Style="{StaticResource Label}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="مرور" Command="{Binding BrowseFfmpegCommand}" Margin="6,0" />
                            <Button Grid.Column="2" Content="ذخیره" Command="{Binding SaveFfmpegCommand}" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,10">
                            <StackPanel>
                                <TextBlock Text="برش یک ویدئو" Style="{StaticResource Label}" />
                                <TextBlock Text="زمان‌ها بر حسب ثانیه‌اند؛ خروجی MP4 در پوشهٔ edited ذخیره می‌شود." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="از ثانیه" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding ClipStart, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="تا ثانیه" Style="{StaticResource Label}" />
                                        <TextBox Text="{Binding ClipEnd, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="برش ویدئو" Style="{StaticResource PrimaryButton}" Command="{Binding TrimCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="تبدیل قالب" Style="{StaticResource Label}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Width="110" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" />
                                    <Button Grid.Column="1" Content="تبدیل فایل" Style="{StaticResource PrimaryButton}" Command="{Binding ConvertCommand}" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="تبدیل صدای ویدئو به متن (هوش مصنوعی Whisper)" Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding GroqKeyHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GroqApiKey, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,6,0" ToolTip="کلید اختیاری Groq (gsk_...)" />
                                    <Button Grid.Column="1" Content="ذخیرهٔ کلید Groq" Command="{Binding SaveGroqKeyCommand}" />
                                </Grid>
                                <CheckBox Content="ترجمهٔ مستقیم گفتار به انگلیسی" IsChecked="{Binding TranslateToEnglish}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="پیاده‌سازی گفتار به متن و ارسال به ایجنت" Style="{StaticResource PrimaryButton}" Command="{Binding TranscribeCommand}" Margin="0,0,6,6" />
                                    <Button Content="کپی متن" Command="{Binding CopyTranscriptCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                                <TextBox Text="{Binding TranscriptText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="ساخت تصویر پیش‌نمایش" Command="{Binding PreviewCommand}" Margin="0,0,6,6" />
                            <Button Content="ارسال فایل منتخب به گیت‌هاب" Style="{StaticResource PrimaryButton}" Command="{Binding UploadCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="فایل منتخب فقط از همین پوشه فرستاده می‌شود؛ ارسال از اتصال GitHub ذخیره‌شده در برنامه استفاده می‌کند." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,9" Margin="0,10,0,0">
                <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
