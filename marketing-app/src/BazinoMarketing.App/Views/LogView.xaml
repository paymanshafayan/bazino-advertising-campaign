<UserControl x:Class="BazinoMarketing.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BazinoMarketing.App.ViewModels">
    <Grid Margin="24,18,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="جست‌وجو و پالایش" Style="{StaticResource H3}" />
                        <TextBlock Text="همهٔ رویدادها قبل از ثبت، از کلید و توکن پاک‌سازی می‌شوند؛ کپی و ارسال آن‌ها امن است." Style="{StaticResource Muted}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalAlignment="Center"
                             ToolTip="جست‌وجو در پیام، جزئیات، دسته یا شناسهٔ درخواست" />
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="نوسازی" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                        <Button Content="کپی انتخاب‌شده" Command="{Binding CopySelectedCommand}" Margin="0,0,6,0" />
                        <Button Content="کپی همه" Command="{Binding CopyAllCommand}" Margin="0,0,6,0" />
                        <Button Content="پوشهٔ لاگ" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0">
                        <RadioButton Style="{StaticResource Chip}" Content="همه" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=all}" />
                        <RadioButton Style="{StaticResource Chip}" Content="برنامه" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=app}" />
                        <RadioButton Style="{StaticResource Chip}" Content="GitHub" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=github}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Kling" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=kling}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Zernio" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=zernio}" />
                        <RadioButton Style="{StaticResource Chip}" Content="FLUX" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=flux}" />
                        <RadioButton Style="{StaticResource Chip}" Content="مرورگر" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=browser}" />
                        <RadioButton Style="{StaticResource Chip}" Content="سفارشی" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=custom}" />
                        <RadioButton Style="{StaticResource Chip}" Content="صندوق فرمان" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=mailbox}" />
                        <RadioButton Style="{StaticResource Chip}" Content="وارد کردن" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=import}" />
                        <RadioButton Style="{StaticResource Chip}" Content="عیب‌یابی" IsChecked="{Binding ToolFilter, Converter={StaticResource StringEquals}, ConverterParameter=diag}" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <CheckBox Content="فقط خطاها" IsChecked="{Binding OnlyFailures}" Margin="0,0,14,0" />
                        <CheckBox Content="به‌روزرسانی زنده" IsChecked="{Binding Live}" Margin="0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Entries -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0">
            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" FlowDirection="LeftToRight" />
                            <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0">
                                <TextBlock Text="{Binding LevelText}" FontSize="12" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Tool}" Style="{StaticResource Mono}" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Top" FlowDirection="LeftToRight" TextAlignment="Right" />
                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" Margin="0,3,0,0" FlowDirection="LeftToRight" TextAlignment="Left"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Muted}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" FlowDirection="LeftToRight">
                <Run Text="{Binding LogFolder, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
