<UserControl x:Class="BazinoMarketing.App.Views.DailyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:BazinoMarketing.App.Views.Charts"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma"
             Foreground="{StaticResource TextBrush}"
             FontSize="14"
             NumberSubstitution.Substitution="European"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,10">
        <StackPanel MaxWidth="1180" x:Name="Root">

            <!-- Toolbar -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="گزارش روزانه" Style="{StaticResource H2}" />
                            <Border Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HandleText, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding HandleText}" FontSize="12" Foreground="{StaticResource Accent2Brush}" FlowDirection="LeftToRight" />
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}">
                            <Run Text="تاریخ گزارش: " />
                            <Run Text="{Binding ReportDateText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  •  بازهٔ داده: " />
                            <Run Text="{Binding PeriodText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding GeneratedText}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding Message}"
                                   Foreground="{StaticResource Accent2Brush}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding BusyText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="خواندن گزارش‌ها از مخزن" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <RadioButton Style="{StaticResource Chip}" Content="۷ روز" IsChecked="{Binding IsWindow7, Mode=OneWay}" Command="{Binding WindowCommand}" CommandParameter="7" />
                            <RadioButton Style="{StaticResource Chip}" Content="۱۴ روز" IsChecked="{Binding IsWindow14, Mode=OneWay}" Command="{Binding WindowCommand}" CommandParameter="14" />
                            <RadioButton Style="{StaticResource Chip}" Content="۳۰ روز" IsChecked="{Binding IsWindow30, Mode=OneWay}" Command="{Binding WindowCommand}" CommandParameter="30" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}" Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="گزارشی برای نمایش نیست" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" MaxWidth="620" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}" MaxWidth="620" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0"
                               Text="این صفحه فقط گزارش‌های ساخته‌شده را می‌خواند؛ خودش چیزی نمی‌سازد و هیچ داده‌ای را حدس نمی‌زند. ساخت گزارش، کار خودِ برنامه است." />
                </StackPanel>
            </Border>

            <!-- Content -->
            <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">

                <!-- KPI tiles -->
                <ItemsControl ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatTile}" MinWidth="200">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{Binding Accent}">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource H3}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <charts:CountUpText Value="{Binding Value}" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"
                                                        Foreground="{StaticResource TextBrush}" FlowDirection="LeftToRight" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Reach + followers -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="بازدید روزانه" Style="{StaticResource H2}" />
                                <TextBlock Text="{Binding WindowText}" Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,6" Text="هر ستون، بازدید یک روز است؛ ستون تیره‌تر، آخرین روز." />
                            <charts:BarChartPanel Height="220" Values="{Binding ReachValues}" Labels="{Binding ReachLabels}"
                                                  BarBrush="{StaticResource ChartBarSoftBrush}" HighlightBrush="{StaticResource ChartBarBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="روند دنبال‌کننده‌ها" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,6" Text="آخرین مقدار ثبت‌شده در گزارش." />
                            <charts:LineChartPanel Height="220" Values="{Binding FollowerValues}" Labels="{Binding FollowerLabels}"
                                                   StrokeBrush="{StaticResource ChartLineBrush}" AreaBrush="{StaticResource ChartAreaBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Engagement split + posts -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="ترکیب تعامل" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,6" Text="سهم هر نوع تعامل از کل." />
                            <charts:DonutChartPanel Height="190" Segments="{Binding BreakdownValues}" Palette="{Binding BreakdownBrushes}"
                                                    CentreValue="{Binding CenterValue}" CentreLabel="{Binding CenterLabel}" />
                            <ItemsControl ItemsSource="{Binding Breakdown}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                            <Border Style="{StaticResource LegendTile}" Background="{Binding Accent}" />
                                            <TextBlock Text="{Binding Icon}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Margin="4,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ValueText}" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SharePercent, StringFormat={}{0}٪}" Margin="4,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasPosts, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="بهترین پست‌های بازه" Style="{StaticResource H2}" Margin="18,16,18,4" />
                            <TextBlock Style="{StaticResource Caption}" Margin="18,0,18,10" Text="مرتب‌شده بر پایهٔ دسترسی؛ مقایسه فقط بین پست‌های هم‌سن و هم‌قالب معنا دارد." />
                            <Grid Background="{StaticResource SurfaceAltBrush}" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="پست" Style="{StaticResource Caption}" Margin="18,8,8,8" />
                                <TextBlock Grid.Column="1" Text="قالب" Style="{StaticResource Caption}" Margin="4,8" />
                                <TextBlock Grid.Column="2" Text="دسترسی" Style="{StaticResource Caption}" Margin="4,8" />
                                <TextBlock Grid.Column="3" Text="لایک" Style="{StaticResource Caption}" Margin="4,8" />
                                <TextBlock Grid.Column="4" Text="کامنت" Style="{StaticResource Caption}" Margin="4,8" />
                                <TextBlock Grid.Column="5" Text="ذخیره" Style="{StaticResource Caption}" Margin="4,8" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Posts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Margin="18,8,8,8" TextWrapping="Wrap" FontSize="13" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="4,8" Style="{StaticResource Muted}" FlowDirection="LeftToRight" />
                                                <TextBlock Grid.Column="2" Text="{Binding Reach}" Margin="4,8" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="3" Text="{Binding Likes}" Margin="4,8" FontSize="13" />
                                                <TextBlock Grid.Column="4" Text="{Binding Comments}" Margin="4,8" FontSize="13" />
                                                <TextBlock Grid.Column="5" Text="{Binding Saves}" Margin="4,8" FontSize="13" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource FlatCard}" Padding="16,12" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="داده‌های اینستاگرام تا ۴۸ ساعت ممکن است دیر برسند؛ روزهای آخر می‌توانند موقتی باشند. هر بخشی که سرویس تحلیل آن را نداده باشد، «در دسترس نبوده» ثبت می‌شود و هرگز با صفر جایگزین نمی‌شود. این صفحه فقط‌خواندنی است." />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
