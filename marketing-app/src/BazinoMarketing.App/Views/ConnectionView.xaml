<UserControl x:Class="BazinoMarketing.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Vazirmatn, Segoe UI, Tahoma"
             Foreground="{StaticResource TextBrush}"
             FontSize="14"
             NumberSubstitution.Substitution="European"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,10">
        <StackPanel MaxWidth="1220">

            <!-- Action bar -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OverallText}" Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding PhaseNote}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding MailboxText}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="بررسی همه" Style="{StaticResource PrimaryButton}" Command="{Binding CheckAllCommand}" Margin="0,0,8,0" />
                        <Button Content="بررسی شبکه" Style="{StaticResource GhostButton}" Command="{Binding ProbeCommand}" Margin="0,0,8,0" />
                        <Button Content="کپی بستهٔ عیب‌یابی" Style="{StaticResource GhostButton}" Command="{Binding CopyDiagnosticsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{Binding DiagnosticsMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}"
                       Margin="6,10,6,0" TextWrapping="Wrap" TextAlignment="Right"
                       Visibility="{Binding DiagnosticsMessage, Converter={StaticResource StringToVis}}" />

            <!-- Command mailbox -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" DataContext="{Binding Mailbox}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StatusKind, Converter={StaticResource MailboxDotBrush}}" />
                            <TextBlock Text="صندوق فرمان" Style="{StaticResource H2}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding LastPollText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Caption}"><Run Text="اثر انگشت ایجنت: " /><Run Text="{Binding AgentFingerprint, Mode=OneWay}" FlowDirection="LeftToRight" /></TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="16,0,0,0"><Run Text="اثر انگشت برنامه: " /><Run Text="{Binding AppFingerprint, Mode=OneWay}" FlowDirection="LeftToRight" /></TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Right" />

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="آخرین فرمان‌های اجراشده" Style="{StaticResource H3}" />
                            <ItemsControl ItemsSource="{Binding Activity}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FlatCard}" Padding="12,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                                <TextBlock Grid.Column="1" Text="{Binding Cmd}" Style="{StaticResource Mono}" Margin="12,0,0,0" FlowDirection="LeftToRight" />
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding DurationMs, StringFormat={}{0} ms}" Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" FlowDirection="LeftToRight" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Button Content="{Binding RestartText}" Style="{StaticResource PrimaryButton}" Command="{Binding RestartCommand}" />
                        <Button Content="بررسی صندوق همین حالا" Style="{StaticResource GhostButton}" Command="{Binding PollNowCommand}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tool tiles -->
            <TextBlock Text="ابزارها" Style="{StaticResource H2}" Margin="4,18,4,4" />
            <TextBlock Style="{StaticResource Caption}" Margin="4,0,4,10"
                       Text="هر ابزار با رنگ و نشان خودش: وضعیت، خلاصهٔ آخرین بررسی و کلید میان‌بر به تنظیمات." />
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="392" Margin="0,0,12,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Background="{Binding BrandBrush}">
                                        <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top"
                                            Background="{Binding State, Converter={StaticResource StateToSoftBrush}}">
                                        <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,10,0,0" Text="{Binding StatusSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="36" />
                                <TextBlock Margin="0,4,0,0" Text="{Binding StatusDetail}" Style="{StaticResource Mono}" FontSize="12"
                                           FlowDirection="LeftToRight" TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding StatusDetail, Converter={StaticResource StringToVis}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{Binding ActionText}" Style="{StaticResource GhostButton}" Command="{Binding TestCommand}" />
                                    <Button Content="{Binding SecondaryCommandText}" Style="{StaticResource GhostButton}" Command="{Binding SecondaryCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding HasSecondaryCommand, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="تنظیمات" Style="{StaticResource LinkButton}" Click="OpenSettings_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Local data folders -->
            <Border Style="{StaticResource Card}" Margin="0,6,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="پوشهٔ دادهٔ همین رایانه" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="بازکردن پوشهٔ داده" Style="{StaticResource GhostButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="بازکردن لاگ‌ها" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
