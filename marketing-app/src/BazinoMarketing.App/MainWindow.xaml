<Window x:Class="BazinoMarketing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BazinoMarketing.App.Views"
        Title="ژینوس — استودیوی تبلیغات و بازاریابی بازینو"
        Icon="pack://application:,,,/Assets/bazino.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        FontFamily="Vazirmatn, Segoe UI, Tahoma"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <views:MainView x:Name="Root" />
</Window>
